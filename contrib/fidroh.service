[Unit]
Description=fidroh tunnel server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fidroh
Group=fidroh
# systemd creates /var/lib/fidroh owned by fidroh, mode 0700
StateDirectory=fidroh
StateDirectoryMode=0700
Environment=FIDROH_DATA_DIR=/var/lib/fidroh
ExecStart=/usr/local/bin/fidroh serve --upstream 127.0.0.1:8000
Restart=on-failure
RestartSec=5

# Hardening: fidroh only needs the network and its own state dir
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# AF_NETLINK lets iroh watch network interface changes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target